# GEMINI_API_KEY: Required for server-side Gemini AI code explanations and chat.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. local PostgreSQL or Aiven/hosted Postgres).
# Example: postgres://username:password@hostname:5432/code_explainer_ai?sslmode=require
DATABASE_URL=

# PORT: Server port (defaults to 3000)
PORT=3000
